# Copy to .env (gitignored). Read by Settings.from_env() in the CLI scripts and the Streamlit app.
# These are the only variables those read; the API server has its own (docs/API.md), and tracing
# has its own (docs/OBSERVABILITY.md). Everything else is set in code.

# LLM provider keys (optional: without one, reports come from the deterministic template).
# The provider is PHARMGUARD_LLM_PROVIDER if set, otherwise the first key found in this order.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# PHARMGUARD_LLM_PROVIDER=anthropic      # anthropic | openai | gemini
# PHARMGUARD_LLM_MODEL=                  # default per provider: claude-sonnet-5, gpt-4o-mini, gemini-3.8-flash
# PHARMGUARD_LLM_TEMPERATURE=0.1         # OpenAI and Gemini only; current Anthropic models reject it

# Data build: the folder that contains processed/ (default ./data, the synthetic sample after
# `python scripts/ingest_data.py --sample`). For the real public build: data/profiles/public
# PHARMGUARD_DATA_DIR=./data

# Live RxNorm lookup for names missing from the local vocabulary (default on for the CLI; off in the API
# and in tests). Needs network access to rxnav.nlm.nih.gov.
# PHARMGUARD_RXNORM_API_ENABLED=true
# PHARMGUARD_MIN_CONFIDENCE=10.0         # minimum RxNorm approximateTerm score for a live match

# openFDA FAERS lookup for pairs with no curated record (default off). Needs network access.
# PHARMGUARD_FAERS_ENABLED=true

