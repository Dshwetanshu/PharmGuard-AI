# Choose ONE LLM provider by setting its API key.
# The system auto-detects which provider to use.

# Anthropic Claude (recommended default)
ANTHROPIC_API_KEY=

# OpenAI (GPT-4, GPT-4o)
OPENAI_API_KEY=

# Google Gemini (matches the original proposal)
GOOGLE_API_KEY=

# -----------------------------------------------------
# Model selection (optional — sensible defaults per provider)
# -----------------------------------------------------
# PHARMGUARD_LLM_PROVIDER=anthropic      # anthropic | openai | gemini
# PHARMGUARD_LLM_MODEL=claude-sonnet-4-6
# PHARMGUARD_LLM_TEMPERATURE=0.1

# -----------------------------------------------------
# Paths (optional — defaults to ./data)
# -----------------------------------------------------
# PHARMGUARD_DATA_DIR=./data
# PHARMGUARD_VECTOR_DB_PATH=./data/processed/chroma

# -----------------------------------------------------
# Retrieval knobs
# -----------------------------------------------------
# PHARMGUARD_TOP_K=5
# PHARMGUARD_MIN_CONFIDENCE=0.0

# -----------------------------------------------------
# OpenFDA FAERS live-query fallback (off by default)
# Requires network access. Opt in if you want PharmGuard to fall back
# to FDA adverse-event reports for pairs not found in the local index.
# -----------------------------------------------------
# PHARMGUARD_FAERS_ENABLED=true

# -----------------------------------------------------
# RxNorm REST API fallback for drug-name resolution (ON by default)
# When the user types a drug not in the local vocabulary, the system
# queries https://rxnav.nlm.nih.gov to resolve it. Handles virtually any
# FDA-approved drug, misspellings, and brand names.
# Set to 'false' if you want to run fully offline.
# -----------------------------------------------------
# PHARMGUARD_RXNORM_API_ENABLED=true
