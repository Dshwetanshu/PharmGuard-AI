# PharmGuard API on Vercel Functions (container image on Fluid compute).
#
# Same image as ./Dockerfile (base digest, hashed lock file, non-root user, start-up
# download and verification of the public build), with three platform changes:
# - the server listens on $PORT (Vercel's default is 80, which a non-root user can't
#   bind, so the project sets PORT=8080 and this file defaults to it);
# - the build is downloaded to /tmp, in case the root filesystem is read-only;
# - no HEALTHCHECK (Vercel routes traffic itself; the check hard-coded port 7860).
#
# Deployed only by scripts/deploy_vercel.py, from a staging folder holding just the
# files this image needs. Local check (read-only root filesystem, like a locked-down host):
#   docker build -f Dockerfile.vercel -t pharmguard-vercel .
#   docker run --rm --read-only --tmpfs /tmp -p 8080:8080 -e PHARMGUARD_HF_DATASET=... \
#     -e PHARMGUARD_HF_REVISION=... -e PHARMGUARD_HF_PROVENANCE_SHA256=... pharmguard-vercel

# python:3.11-slim, multi-arch index digest (linux/amd64 + linux/arm64), pinned 2026-09-24
FROM python:3.11-slim@sha256:da047cb8f9d1d98e5c070f5300ba9f7274e33b8fc0e5be5ed88740aed1b95ba9

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PHARMGUARD_DATA_DIR=/tmp/pharmguard/public \
    PHARMGUARD_REQUIRED_PROFILE=public \
    PHARMGUARD_RXNORM_API_ENABLED=false \
    PHARMGUARD_TRACING=none \
    HF_HOME=/tmp/hf \
    PORT=8080

WORKDIR /app
COPY requirements-api.lock .
RUN pip install --require-hashes --no-deps -r requirements-api.lock

RUN useradd --uid 1000 --create-home --shell /usr/sbin/nologin pharmguard

COPY --chown=pharmguard:pharmguard src/ ./src/
COPY --chown=pharmguard:pharmguard api/ ./api/

USER pharmguard
EXPOSE 8080

# --no-proxy-headers: client IPs come only from api.ratelimit.client_ip (trusted hops).
CMD ["sh", "-c", "exec uvicorn api.app:app --host 0.0.0.0 --port \"${PORT:-8080}\" --no-access-log --no-proxy-headers --timeout-graceful-shutdown 10"]
